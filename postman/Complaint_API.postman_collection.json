{
  "info": {
    "name": "Campus Complaint Tracker API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "TC01 POST valid complaint",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 201\",()=>pm.response.to.have.status(201));",
              "const j=pm.response.json();pm.test(\"data returned\",()=>{pm.expect(j.id).to.be.a(\"number\");pm.expect(j.category).to.eql(\"WiFi / Internet\")});pm.collectionVariables.set(\"id\",j.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/complaints",
        "body": {
          "mode": "raw",
          "raw": "{\"studentName\": \"Saira Abbas\", \"rollNo\": \"K22SW006\", \"category\": \"WiFi / Internet\", \"description\": \"WiFi is not working in the Software Engineering department.\", \"status\": \"Pending\"}"
        }
      }
    },
    {
