    {
      "name": "TC09 DELETE complaint",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// create a temporary complaint (Water) that TC09 will delete, so the other complaints stay in the database",
              "pm.sendRequest({url: pm.collectionVariables.get('baseUrl') + '/api/complaints', method: 'POST', header: {'Content-Type': 'application/json'}, body: {mode: 'raw', raw: \"{\\\"studentName\\\": \\\"Saira Abbas\\\", \\\"rollNo\\\": \\\"K22SW006\\\", \\\"category\\\": \\\"Water\\\", \\\"description\\\": \\\"Temporary complaint created for the delete test.\\\", \\\"status\\\": \\\"Pending\\\"}\"}}, (err, res) => { pm.collectionVariables.set('tmpId', res.json().id); });"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\",()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ],
